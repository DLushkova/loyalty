<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clubloyalty.client.controller.AdminBonusesController"
      spacing="15" style="-fx-padding: 20;" alignment="CENTER">

    <Label text=" УПРАВЛЕНИЕ БАЛАНСОМ"
           style="-fx-text-fill: #eaeaea; -fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="userIdField" promptText="ID пользователя" maxWidth="300"/>
    <TextField fx:id="moneyAmountField" promptText="Сумма для пополнения" maxWidth="300"/>

    <Button text=" ПОПОЛНИТЬ БАЛАНС" onAction="#handleAddMoney"
            style="-fx-background-color: #533483; -fx-text-fill: white; -fx-padding: 10 20;"/>

    <Button text=" НАЧИСЛИТЬ БОНУСЫ " onAction="#handleAddBonus"
            style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-padding: 10 20;"/>

    <Label fx:id="messageLabel" textFill="red"/>

</VBox>